{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generic-ai.dev/contracts/goals/goal-spec.schema.json",
  "title": "GoalSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "objective",
    "definitionOfDone",
    "validators"
  ],
  "properties": {
    "schemaVersion": {
      "const": "generic-ai.goal/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "definitionOfDone": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validator"
      }
    },
    "protectedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "validator": {
      "anyOf": [
        {
          "$ref": "#/$defs/numeric"
        },
        {
          "$ref": "#/$defs/rubric"
        },
        {
          "$ref": "#/$defs/trace"
        },
        {
          "$ref": "#/$defs/output_schema"
        },
        {
          "$ref": "#/$defs/check"
        }
      ]
    },
    "numeric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "operator"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "maxLength": 128
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "fixHint": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "kind": {
          "const": "numeric"
        },
        "source": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "metric"
              ],
              "properties": {
                "metric": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outputPath"
              ],
              "properties": {
                "outputPath": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "pattern": "^(output|artifact:.+)$"
                }
              }
            }
          ]
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "between"
          ]
        },
        "value": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "criteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "maxLength": 128
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "fixHint": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "kind": {
          "const": "rubric"
        },
        "target": {
          "type": "string",
          "pattern": "^(output|artifact:.+)$"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                "maxLength": 128
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "required": {
                "type": "boolean"
              },
              "passScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "passThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "judgeRef": {
          "type": "string",
          "minLength": 1
        },
        "judgeInstructions": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "traceMatcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "maxLength": 128
        },
        "description": {
          "type": "string"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "started",
            "completed",
            "failed",
            "any"
          ]
        },
        "argsInclude": {
          "type": "object"
        },
        "minCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "maxLength": 128
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "fixHint": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "kind": {
          "const": "trace"
        },
        "require": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceMatcher"
          }
        },
        "forbid": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceMatcher"
          }
        },
        "ordered": {
          "type": "boolean"
        }
      }
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "schema"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "maxLength": 128
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "fixHint": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "kind": {
          "const": "output_schema"
        },
        "target": {
          "type": "string",
          "pattern": "^(output|artifact:.+)$"
        },
        "schema": {
          "type": "object"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "checkRef"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "maxLength": 128
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "fixHint": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "kind": {
          "const": "check"
        },
        "checkRef": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
