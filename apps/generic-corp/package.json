{
  "name": "@generic-ai/app-generic-corp",
  "version": "0.0.0",
  "description": "Generic Corp, the flagship app on Generic AI: one owner runs a company of goal-driven agents. Scaffold only; wired to the starter preset.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "check:node": "node ../../scripts/check-node-version.mjs",
    "prebuild": "node ../../scripts/check-node-version.mjs",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run --root ../.. --config vitest.config.ts apps/generic-corp/src",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@generic-ai/preset-starter-hono": "0.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "private": true
}
