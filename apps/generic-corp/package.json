{
  "name": "@generic-ai/app-generic-corp",
  "version": "0.0.0",
  "description": "Generic Corp, the flagship app on Generic AI: one owner runs a company of goal-driven agents through a CEO, an org chart and a durable delegation cascade.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "check:node": "node ../../scripts/check-node-version.mjs",
    "prebuild": "node ../../scripts/check-node-version.mjs",
    "build": "tsc -b && npm run build:web",
    "typecheck": "tsc -b --pretty && tsc -p web/tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.config.ts apps/generic-corp/src",
    "e2e": "playwright test",
    "lint": "biome lint .",
    "prestart": "node ../../scripts/check-node-version.mjs",
    "start": "node dist/run.js",
    "evals": "node dist/evals-cli.js",
    "reliability": "bash scripts/reliability.sh",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@generic-ai/ai": "0.0.0",
    "@generic-ai/auth": "0.0.0",
    "@generic-ai/continual": "0.0.0",
    "@generic-ai/core": "0.0.0",
    "@generic-ai/plugin-agent-skills": "0.0.0",
    "@generic-ai/plugin-approvals": "0.0.0",
    "@generic-ai/plugin-auth-identity": "0.0.0",
    "@generic-ai/plugin-delegation": "0.0.0",
    "@generic-ai/plugin-mcp": "0.0.0",
    "@generic-ai/plugin-secrets": "0.0.0",
    "@generic-ai/plugin-storage-postgres": "0.0.0",
    "@generic-ai/plugin-storage-sqlite": "0.0.0",
    "@generic-ai/plugin-tools-documents": "0.0.0",
    "@generic-ai/plugin-tools-files": "0.0.0",
    "@generic-ai/plugin-tools-terminal": "0.0.0",
    "@generic-ai/plugin-tools-web": "0.0.0",
    "@generic-ai/preset-starter-hono": "0.0.0",
    "@generic-ai/resources": "0.0.0",
    "@generic-ai/rlm": "0.0.0",
    "@generic-ai/sdk": "0.0.0",
    "@sinclair/typebox": "0.34.49",
    "hono": "^4.12.15",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "preact": "^10.27.2",
    "vite": "^8.4.0"
  },
  "files": [
    "dist",
    "public",
    "skills",
    "templates",
    "README.md"
  ]
}
