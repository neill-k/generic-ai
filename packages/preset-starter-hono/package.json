      "planning",
      "coordination",
      "memory",
      "communication",
      "tool-policy",
      "reporting"
    ]
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neill-k/generic-ai.git",
    "directory": "packages/preset-starter-hono"
  },
  "homepage": "https://github.com/neill-k/generic-ai/tree/main/packages/preset-starter-hono#readme",
  "bugs": {
    "url": "https://github.com/neill-k/generic-ai/issues"
  },
  "keywords": [
    "generic-ai",
    "ai-agents",
    "multi-agent"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
