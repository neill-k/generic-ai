  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@generic-ai/core": "0.0.0",
    "@generic-ai/plugin-agent-skills": "0.0.0",
    "@generic-ai/plugin-config-yaml": "0.0.0",
    "@generic-ai/plugin-delegation": "0.0.0",
    "@generic-ai/plugin-hono": "0.0.0",
    "@generic-ai/plugin-logging-otel": "0.0.0",
    "@generic-ai/plugin-lsp": "0.0.0",
    "@generic-ai/plugin-mcp": "0.0.0",
    "@generic-ai/plugin-memory-files": "0.0.0",
    "@generic-ai/plugin-messaging": "0.0.0",
    "@generic-ai/plugin-output-default": "0.0.0",
    "@generic-ai/plugin-queue-memory": "0.0.0",
    "@generic-ai/plugin-repo-map": "0.0.0",
    "@generic-ai/plugin-storage-sqlite": "0.0.0",
    "@generic-ai/plugin-tools-files": "0.0.0",
    "@generic-ai/plugin-tools-terminal": "0.0.0",
    "@generic-ai/plugin-tools-terminal-sandbox": "0.0.0",
    "@generic-ai/plugin-workspace-fs": "0.0.0",
    "@generic-ai/sdk": "0.0.0"
  },
  "license": "MIT",
  "genericAi": {
    "kind": "preset",
