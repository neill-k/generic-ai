{
  "name": "@generic-ai/session",
  "version": "0.0.0",
  "description": "Sessions for the Generic AI native runtime: an append-only JSONL session tree with branching and resume, context compaction and branch summaries, usage totals, and retry on transient provider errors.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b --noEmit --pretty false"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@generic-ai/agent": "0.0.0",
    "@generic-ai/ai": "0.0.0",
    "@generic-ai/tools": "0.0.0"
  },
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
