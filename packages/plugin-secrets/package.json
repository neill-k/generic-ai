{
  "name": "@generic-ai/plugin-secrets",
  "version": "0.0.0",
  "description": "Secrets plugin for Generic AI: env, file and encrypted-store secret sources, per-role grants, {{secret:NAME}} placeholders resolved at tool-call time, and redaction of secret values from tool output, events and traces.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@generic-ai/sdk": "0.0.0"
  },
  "license": "MIT",
  "genericAi": {
    "kind": "plugin",
    "category": "infra",
    "method": "secrets-vault.v1"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neill-k/generic-ai.git",
    "directory": "packages/plugin-secrets"
  },
  "homepage": "https://github.com/neill-k/generic-ai/tree/main/packages/plugin-secrets#readme",
  "bugs": {
    "url": "https://github.com/neill-k/generic-ai/issues"
  },
  "keywords": [
    "generic-ai",
    "ai-agents",
    "multi-agent"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
