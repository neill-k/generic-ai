{
  "name": "@generic-ai/plugin-logging-otel",
  "version": "0.0.0",
  "description": "Structured logging and OpenTelemetry tracing plugin for Generic AI. Consumes kernel session events.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b --noEmit --pretty false"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "genericAi": {
    "kind": "plugin",
    "slot": "reporting",
    "method": "otel-tracing.v1"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neill-k/generic-ai.git",
    "directory": "packages/plugin-logging-otel"
  },
  "homepage": "https://github.com/neill-k/generic-ai/tree/main/packages/plugin-logging-otel#readme",
  "bugs": {
    "url": "https://github.com/neill-k/generic-ai/issues"
  },
  "keywords": [
    "generic-ai",
    "ai-agents",
    "multi-agent"
  ],
  "engines": {
    "node": ">=24.0.0"
  }
}
