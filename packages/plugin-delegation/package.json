{
  "name": "@generic-ai/plugin-delegation",
  "version": "0.0.0",
  "description": "Durable delegation for Generic AI: persistent agents with memory and workspaces, and a cross-run delegation cascade over the durable run store and queue.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@generic-ai/sdk": "0.0.0"
  },
  "license": "MIT",
  "genericAi": {
    "kind": "plugin",
    "slot": "coordination",
    "method": "delegation.v1"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@generic-ai/plugin-storage-postgres": "0.0.0",
    "@generic-ai/plugin-storage-sqlite": "0.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neill-k/generic-ai.git",
    "directory": "packages/plugin-delegation"
  },
  "homepage": "https://github.com/neill-k/generic-ai/tree/main/packages/plugin-delegation#readme",
  "bugs": {
    "url": "https://github.com/neill-k/generic-ai/issues"
  },
  "keywords": [
    "generic-ai",
    "ai-agents",
    "multi-agent"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
