{
  "name": "@generic-ai/plugin-lsp",
  "version": "0.0.0",
  "description": "Configurable stdio LSP client tools for Generic AI harness runs.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@generic-ai/plugin-workspace-fs": "0.0.0",
    "@generic-ai/sdk": "0.0.0",
    "@sinclair/typebox": "0.34.49"
  },
  "license": "MIT",
  "genericAi": {
    "kind": "plugin",
    "slot": "tool-policy",
    "method": "lsp-read.v1"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neill-k/generic-ai.git",
    "directory": "packages/plugin-lsp"
  },
  "homepage": "https://github.com/neill-k/generic-ai/tree/main/packages/plugin-lsp#readme",
  "bugs": {
    "url": "https://github.com/neill-k/generic-ai/issues"
  },
  "keywords": [
    "generic-ai",
    "ai-agents",
    "multi-agent"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
