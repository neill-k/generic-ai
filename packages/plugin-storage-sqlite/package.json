{
  "name": "@generic-ai/plugin-storage-sqlite",
  "version": "0.0.0",
  "description": "Durable SQLite-backed storage for Generic AI: key-value storage plus a run store and durable queue. Default local persistence for the starter preset.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b --noEmit --pretty false"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@generic-ai/sdk": "0.0.0"
  },
  "license": "MIT",
  "genericAi": {
    "kind": "plugin",
    "category": "infra",
    "method": "sqlite-storage.v1"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neill-k/generic-ai.git",
    "directory": "packages/plugin-storage-sqlite"
  },
  "homepage": "https://github.com/neill-k/generic-ai/tree/main/packages/plugin-storage-sqlite#readme",
  "bugs": {
    "url": "https://github.com/neill-k/generic-ai/issues"
  },
  "keywords": [
    "generic-ai",
    "ai-agents",
    "multi-agent"
  ]
}
