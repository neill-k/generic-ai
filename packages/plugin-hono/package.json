{
  "name": "@generic-ai/plugin-hono",
  "version": "0.0.0",
  "description": "Hono integration plugin for Generic AI. Official but optional; included by default in the starter preset.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@generic-ai/sdk": "0.0.0",
    "hono": "^4.12.15"
  },
  "license": "MIT",
  "genericAi": {
    "kind": "plugin",
    "category": "transport",
    "method": "hono.v1"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neill-k/generic-ai.git",
    "directory": "packages/plugin-hono"
  },
  "homepage": "https://github.com/neill-k/generic-ai/tree/main/packages/plugin-hono#readme",
  "bugs": {
    "url": "https://github.com/neill-k/generic-ai/issues"
  },
  "keywords": [
    "generic-ai",
    "ai-agents",
    "multi-agent"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
